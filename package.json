{
  "name": "rss-reader-prototype",
  "productName": "RSS Reader Prototype",
  "version": "0.1.0",
  "description": "A small Windows-native Electron RSS/Atom reader prototype.",
  "private": true,
  "main": ".vite/build/main.cjs",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-forge start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx packages/db/src/cli/migrate.ts",
    "db:reset": "tsx packages/db/src/cli/reset.ts",
    "package": "electron-forge package"
  },
  "dependencies": {
    "@rss-reader/contracts": "workspace:*",
    "@rss-reader/db": "workspace:*",
    "@rss-reader/feeds": "workspace:*",
    "dompurify": "3.4.12",
    "dotenv": "17.4.2",
    "jsdom": "30.0.1",
    "kysely": "0.29.4",
    "lucide-react": "^1.30.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@types/node": "24.10.13",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
